WORKING_DIR=/workspace
SPLENT_APP=planner
PYTHONPATH=/workspace/planner/src
FLASK_APP=planner:create_app

MARIADB_HOSTNAME=planner_db
MARIADB_DATABASE=planner_db
MARIADB_TEST_DATABASE=planner_db_test
MARIADB_USER=planner_db_user
MARIADB_PASSWORD=planner_db_password
MARIADB_ROOT_PASSWORD=planner_db_root_password

RUN_DB_SEED=true

# En un servidor público: HOST_BIND_ADDRESS=127.0.0.1 (puertos solo para el proxy)
# y FLASK_DEBUG=0 (sin depurador). En desarrollo local, déjalos así.
HOST_BIND_ADDRESS=0.0.0.0
FLASK_DEBUG=1

# Correo: en desarrollo, a MailHog (los correos se ven en http://localhost:8186, no salen fuera)
MAIL_HOST=splent_feature_mailhog
MAIL_PORT=1025
MAIL_USE_TLS=0
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@localhost
TASK_NOTIFICATIONS_APP_URL=http://localhost:5161
